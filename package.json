{
  "name": "stonewake-final-repo",
  "version": "1.1.0",
  "description": "Stonewake API and UI test automation (Playwright + TypeScript), ITAC 2026 final",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
